.n 2 1 1
0 0
1 1

# 3 = nfkb
.n 3 1 4
0 1
1 0

# 4 = ikb
.n 4 1 3
0 0
1 1

# 5 = lacI
.n 5 1 6
0 1
1 0

# 6 = tetR
.n 6 1 5
0 1
1 0

# 7 = ffl_y
.n 7 1 3
0 0
1 1

# 8 = pulse
.n 8 2 3 7
00 0
01 0
10 1
11 0



